        jdmaster.$(OBJEXT) jdinput.$(OBJEXT) jdmarker.$(OBJEXT) jdhuff.$(OBJEXT) jdphuff.$(OBJEXT) \
        jdmainct.$(OBJEXT) jdcoefct.$(OBJEXT) jdpostct.$(OBJEXT) jddctmgr.$(OBJEXT) \
