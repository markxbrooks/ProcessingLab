	jfdctfst$U.lo jfdctint$U.lo jidctflt$U.lo jidctfst$U.lo \
	jidctint$U.lo jidctred$U.lo jquant1$U.lo jquant2$U.lo \
	jutils$U.lo jmemmgr$U.lo
