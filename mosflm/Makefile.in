# Makefile tail for building ipmosflm on any UNIX box...
# This must be "inc"'d by a header Makefile
DPS    = @top_srcdir@
CC     = @CC@ -c
F77    = @F77@ -c
FLINK  = @F77@
FFLAGS = @FFLAGS@
MOSFLAGS = @MOSFLM_EXTRA_FFLAGS@ @FFLAGS@
CFLAGS = -O0 @CFLAGS@
LIBS = @CCP4_LIBS@ @XDL_LIB@ @X_LIBS@ @X_PRE_LIBS@ \
 @X_EXTRA_LIBS@ @EXTRA_LIBS@ @LIBS@ @CXXLIBS@
LDFLAGS = @LDFLAGS@
ipmosflm_LDFLAGS = @ipmosflm_LDFLAGS@
DPSBIN = ${DPS}/bin
DPSLIB = ${DPS}/lib
M4     = @M4@

SOURCES =  control.f mosflm_all_ip_inc.f unoptimizable.f pck.c \
	ctimer.c datetime.c chelp.c open_socket.c close_socket.c read_socket.c \
	write_socket.c \
	mosflm_jpeg.c fileaccess.c matzerr.c hklmanage.c torefix.f \
	pilatus_c.c pilatus_pck.c cbfwrap.c corecounter.c byteoffset.c \
	mosflm_all_ip_inc_noX.f torefix_noX.f

DIST-OTHERS = add_refix.com

@WITH_X_TRUE@OBJS   = control.o unoptimizable.o pck.o ctimer.o datetime.o chelp.o open_socket.o \
	@WITH_X_TRUE@close_socket.o read_socket.o write_socket.o mosflm_jpeg.o fileaccess.o matzerr.o \
	@WITH_X_TRUE@hklmanage.o pilatus_c.o pilatus_pck.o cbfwrap.o corecounter.o byteoffset.o \
	@WITH_X_TRUE@fromhdf5.o lz4.o h5zlz4.o bshuf_h5filter.o bshuf_h5plugin.o bitshuffle.o \
	@WITH_X_TRUE@mosflm_all_ip_inc.o torefix.o 
@WITH_X_FALSE@OBJS   = control.o unoptimizable.o pck.o ctimer.o datetime.o open_socket.o \
	@WITH_X_FALSE@close_socket.o read_socket.o write_socket.o mosflm_jpeg.o fileaccess.o matzerr.o \
	@WITH_X_FALSE@hklmanage.o pilatus_c.o pilatus_pck.o cbfwrap.o corecounter.o byteoffset.o \
	@WITH_X_FALSE@fromhdf5.o lz4.o h5zlz4.o bshuf_h5filter.o bshuf_h5plugin.o bitshuffle.o \
	@WITH_X_FALSE@mosflm_all_ip_inc_noX.o torefix_noX.o

LOCALLIBS   = ${DPSLIB}/libdps_index.a ${DPSLIB}/DPSLIB.a ${DPSLIB}/libfftpack.a ${DPS}/cbf/lib/libcbf.a

.SUFFIXES:	.o .c .f

.c.o:
	${CC} ${CFLAGS} -o $@ $<

.f.o:
	${F77} ${FFLAGS} -o $@ $<

# Phase D / D6: amalgamation opt-in via MOSFLM_FORTRAN_ORACLE=1.
# Default ProcessingLab binary is C++ ProcessingLab (processing-lab/).
MOSFLM_CPP_DIR = ../processing-lab
MOSFLM_CPP_BUILD = $(MOSFLM_CPP_DIR)/build

ipmosflm:
	@if [ "$(MOSFLM_FORTRAN_ORACLE)" = "1" ]; then \
	  $(MAKE) ipmosflm-oracle; \
	else \
	  echo "Phase D / D6: Fortran amalgamation is opt-in."; \
	  echo "  make MOSFLM_FORTRAN_ORACLE=1 ipmosflm"; \
	  echo "Default C++ CONTROL binary (ProcessingLab):"; \
	  echo "  cmake --build $(MOSFLM_CPP_BUILD) --target ProcessingLab"; \
	  false; \
	fi

ipmosflm-oracle:	${OBJS}
		mkdir -p ${DPSBIN}
		${FLINK} ${ipmosflm_LDFLAGS} ${FFLAGS} ${OBJS} ${LOCALLIBS} ${LIBS} \
                -o ${DPSBIN}/ipmosflm ${LDFLAGS}

@INT_BYTE_TRUE@mosflm_all_ip_inc.o: mosflm_all_ip_inc.f
	@INT_BYTE_TRUE@${F77} ${MOSFLAGS} mosflm_all_ip_inc.f

@INT_BYTE_FALSE@mosflm_all_ip_inc.o: mosflm_all_ip_inc.f
	@INT_BYTE_FALSE@/bin/mv -f mosflm_all_ip_inc.f mosflm_all_ip_inc.f.bak
	@INT_BYTE_FALSE@sed s/"integer\*1"/"BYTE"/ mosflm_all_ip_inc.f.bak > mosflm_all_ip_inc.f
	@INT_BYTE_FALSE@${F77} ${MOSFLAGS} mosflm_all_ip_inc.f
	@INT_BYTE_FALSE@/bin/mv -f mosflm_all_ip_inc.f.bak mosflm_all_ip_inc.f

@INT_BYTE_TRUE@mosflm_all_ip_inc_noX.o: mosflm_all_ip_inc_noX.f
	@INT_BYTE_TRUE@${F77} ${MOSFLAGS} mosflm_all_ip_inc_noX.f

@INT_BYTE_FALSE@mosflm_all_ip_inc_noX.o: mosflm_all_ip_inc_noX.f
	@INT_BYTE_FALSE@/bin/mv -f mosflm_all_ip_inc_noX.f mosflm_all_ip_inc_noX.f.bak
	@INT_BYTE_FALSE@sed s/"integer\*1"/"BYTE"/ mosflm_all_ip_inc_noX.f.bak > mosflm_all_ip_inc_noX.f
	@INT_BYTE_FALSE@${F77} ${MOSFLAGS} mosflm_all_ip_inc_noX.f
	@INT_BYTE_FALSE@/bin/mv -f mosflm_all_ip_inc_noX.f.bak mosflm_all_ip_inc_noX.f


control.o:  control.f
		${F77} ${FFLAGS} -O0 control.f

unoptimizable.o: unoptimizable.f
		${F77} ${FFLAGS} -O0 unoptimizable.f

pck.o: pck.c
		${CC} ${CFLAGS} pck.c

chelp.o: chelp.c
		${CC} ${CFLAGS} -I${DPS} chelp.c

mosflm_jpeg.o: mosflm_jpeg.c
		${CC} ${CFLAGS} mosflm_jpeg.c

# for HDF5 files
fromhdf5.o: fromhdf5.c
	${CC} -c  ${CFLAGS} fromhdf5.c

lz4.o:  ../third_party/lz4/lz4.c
	${CC} -c -I../third_party/lz4 ../third_party/lz4/lz4.c

h5zlz4.o:       ../third_party/lz4/h5zlz4.c
	${CC} -c -std=c99 ${CFLAGS} -I../third_party/lz4 ../third_party/lz4/h5zlz4.c

bshuf_h5filter.o:        ../third_party/bitshuffle/bshuf_h5filter.c
	${CC} -c ${CFLAGS} -I../third_party/lz4 ../third_party/bitshuffle/bshuf_h5filter.c

bshuf_h5plugin.o:        ../third_party/bitshuffle/bshuf_h5plugin.c
	${CC} -c ${CFLAGS} -I../third_party/lz4 ../third_party/bitshuffle/bshuf_h5plugin.c

bitshuffle.o:    ../third_party/bitshuffle/bitshuffle.c
	${CC} -c -std=c99 ${CFLAGS} -I../third_party/lz4 ../third_party/bitshuffle/bitshuffle.c

clean-compile:
	rm -f ${OBJS} core *core

clean-bin:
	-test -z ${DPSBIN}/ipmosflm || rm -f ${DPSBIN}/ipmosflm

clean-generic:
	-rm -f *~

clean: clean-generic clean-compile clean-bin

distclean-generic:
	-rm -f Makefile

distclean: distclean-generic clean

realclean: distclean
	-rm -f ${SOURCES} ${DIST-OTHERS}

uninstall:

check:
# This only checks the syntax of this Makefile!
	cat -v -t -e Makefile|more

